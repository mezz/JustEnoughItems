def runExternalPublishTask(String gradleTask) {
    def maxAttempts = 3

    for (def attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
            sh "./gradlew ${gradleTask} --no-daemon"
            return
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
            throw e
        } catch (Exception e) {
            if (attempt >= maxAttempts) {
                throw e
            }

            echo "External publish task '${gradleTask}' failed on attempt ${attempt}/${maxAttempts}; retrying in 2 minutes."
            sleep time: 2, unit: 'MINUTES'
        }
    }
}

pipeline {
    agent any
    tools {
        jdk "jdk-17.0.1"
    }

    environment {
      ORG_GRADLE_PROJECT_curseforgeApikey = credentials("jei-curseforge-key")
      ORG_GRADLE_PROJECT_modrinthToken = credentials("modrinth-auth-token")
      ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
      DISCORD_WEBHOOK_URL = credentials("jei-discord-webhook-url")
      GITHUB_RELEASE_COMMENT_TOKEN = credentials("github-release-comment-token")
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "rm -rf Forge/build/libs"
                sh "rm -rf Fabric/build/libs"
            }
        }

        stage('Test') {
            steps {
                sh "./gradlew test --no-daemon"
            }
        }

        stage('Build') {
            steps {
                sh "./gradlew :Core:build --no-daemon"
                sh "./gradlew :Forge:build --no-daemon"
                sh "./gradlew :Fabric:build --no-daemon"
                sh "./gradlew :Common:build --no-daemon"
                sh "./gradlew :CommonApi:build --no-daemon"
                sh "./gradlew :ForgeApi:build --no-daemon"
                sh "./gradlew :FabricApi:build --no-daemon"
            }
        }

        stage('Archive') {
            steps {
                junit allowEmptyResults: true, testResults: '*/build/test-results/**/*.xml'
            }
        }

        stage('Check Publish Changes') {
            steps {
                script {
                    def publishGuard = load '.jenkins/publishGuard.groovy'
                    env.SHOULD_PUBLISH = publishGuard.shouldPublishArtifacts() ? 'true' : 'false'
                }
            }
        }

        stage('Publish Maven') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' }
            }
            steps {
                sh "./gradlew :Core:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :Gui:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :Library:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :Forge:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :Fabric:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :Common:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :CommonApi:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :ForgeApi:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
                sh "./gradlew :FabricApi:publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
            }
        }

        stage('Publish CurseForge') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' }
            }
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                        runExternalPublishTask(':Fabric:publishCurseforge')
                    }
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                        runExternalPublishTask(':Forge:publishCurseforge')
                    }
                }
            }
        }

        stage('Publish Modrinth') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' }
            }
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                        runExternalPublishTask(':Fabric:publishModrinth')
                    }
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                        runExternalPublishTask(':Forge:publishModrinth')
                    }
                }
            }
        }

        stage('Comment GitHub Release') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' && env.GITHUB_RELEASE_COMMENT_TOKEN }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withEnv(["GITHUB_TOKEN=${env.GITHUB_RELEASE_COMMENT_TOKEN}"]) {
                        sh "python3 .jenkins/githubReleaseComments.py"
                    }
                }
            }
        }

    }
    post {
        always {
            script {
                def discordNotification = load '.jenkins/discordNotification.groovy'
                discordNotification.notifyDiscordBuildSafely(currentBuild.currentResult)
            }
        }
    }
}

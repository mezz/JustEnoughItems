def releaseCommentStatePrefix() {
    return 'jenkins-github-release-comments-state:v1:'
}

def findPreviousReleaseCommentState() {
    def previousBuild = currentBuild.previousBuild
    while (previousBuild != null) {
        def description = previousBuild.description ?: ''
        if (description.startsWith(releaseCommentStatePrefix())) {
            return description
        }
        previousBuild = previousBuild.previousBuild
    }
    return ''
}

def persistReleaseCommentState(String stateFile) {
    def description = sh(
        script: "python3 .jenkins/githubReleaseComments.py --state-file ${stateFile} --describe-state",
        returnStdout: true
    ).trim()
    currentBuild.description = description
    env.HAS_PENDING_RELEASE_COMMENTS = description.startsWith("${releaseCommentStatePrefix()}pending:") ? 'true' : 'false'
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }
    tools {
        jdk "jdk8u292-b10"
    }

    environment {
        ORG_GRADLE_PROJECT_curseforge_apikey = credentials('jei-curseforge-key')
        ORG_GRADLE_PROJECT_modrinthToken = credentials("modrinth-auth-token")
        ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
        DISCORD_WEBHOOK_URL = credentials("jei-discord-webhook-url")
        GITHUB_RELEASE_COMMENT_TOKEN = credentials("github-release-comment-token")
        GITHUB_RELEASE_COMMENT_EXPECTED_LOGIN = "mezz-bot"
        GITHUB_RELEASE_COMMENT_STATE_FILE = "build/jenkins/github-release-comments-state.json"
        GITHUB_RELEASE_COMMENT_DESCRIPTION_FILE = "build/jenkins/github-release-comments-description.txt"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "rm -rf build/libs"
            }
        }

        stage('Test') {
            steps {
                sh "./gradlew test --no-daemon"
            }
        }

        stage('Restore GitHub Release Comment State') {
            steps {
                script {
                    sh 'mkdir -p build/jenkins'
                    def previousState = findPreviousReleaseCommentState()
                    if (previousState) {
                        writeFile file: env.GITHUB_RELEASE_COMMENT_DESCRIPTION_FILE, text: previousState
                        sh "python3 .jenkins/githubReleaseComments.py --state-file ${env.GITHUB_RELEASE_COMMENT_STATE_FILE} --restore-state-description-file ${env.GITHUB_RELEASE_COMMENT_DESCRIPTION_FILE}"
                    }
                    persistReleaseCommentState(env.GITHUB_RELEASE_COMMENT_STATE_FILE)
                }
            }
        }

        stage('Build') {
            steps {
                sh "python3 -m unittest discover -s .jenkins -p 'test_*.py'"
                sh "./gradlew build --no-daemon"
            }
        }

        stage('Archive') {
            steps {
                junit allowEmptyResults: true, testResults: 'build/test-results/**/*.xml'
            }
        }

        stage('Check Publish Changes') {
            steps {
                script {
                    def publishGuard = load '.jenkins/publishGuard.groovy'
                    env.SHOULD_PUBLISH = publishGuard.shouldPublishArtifacts() ? 'true' : 'false'
                }
            }
        }

        stage('Publish Maven') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' }
            }
            steps {
                sh "./gradlew publish -PDEPLOY_DIR=${env.MAVEN_DEPLOY_DIR} --no-daemon"
            }
        }

        stage('Publish CurseForge') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' }
            }
            steps {
                sh "./gradlew makeChangelog --no-daemon"
                sh "./gradlew curseforge --no-daemon"
            }
        }

        stage('Publish Modrinth') {
            steps {
                sh "./gradlew modrinth --no-daemon"
            }
        }

        stage('Queue GitHub Release Comment') {
            when {
                expression { env.SHOULD_PUBLISH != 'false' && currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                sh "python3 .jenkins/githubReleaseComments.py --state-file ${env.GITHUB_RELEASE_COMMENT_STATE_FILE} --queue-release"
                script {
                    persistReleaseCommentState(env.GITHUB_RELEASE_COMMENT_STATE_FILE)
                }
            }
        }

        stage('Comment GitHub Release') {
            when {
                expression { env.HAS_PENDING_RELEASE_COMMENTS == 'true' && env.GITHUB_RELEASE_COMMENT_TOKEN }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        try {
                            sh "python3 .jenkins/githubReleaseComments.py --token-env GITHUB_RELEASE_COMMENT_TOKEN --state-file ${env.GITHUB_RELEASE_COMMENT_STATE_FILE}"
                        } finally {
                            persistReleaseCommentState(env.GITHUB_RELEASE_COMMENT_STATE_FILE)
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                def discordNotification = load '.jenkins/discordNotification.groovy'
                discordNotification.notifyDiscordBuildSafely(currentBuild.currentResult)
            }
        }
    }
}
